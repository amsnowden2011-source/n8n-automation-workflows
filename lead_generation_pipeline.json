    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Clean up Names\nconst nameParts = ($json.name || \"\").trim().split(\" \");\n$json.firstName = nameParts[0] || \"\";\n$json.lastName = nameParts.length > 1 ? nameParts[nameParts.length - 1] : \"\";\n\n// 2. Normalize the profile URL - Apify's field name varies by actor version, and\n//    the Sheets write at the end matches rows on this value.\n$json.linkedinUrl = $json.linkedinUrl || $json.profileUrl || $json.url\n                 || ($json.publicIdentifier ? `https://www.linkedin.com/in/${$json.publicIdentifier}` : \"\");\n\n// 2b. Job title - prefer the current position, fall back to the profile headline.\n$json.jobTitle = $json.currentPositions?.[0]?.title || $json.headline || \"\";\n\n// 3. Identify the Company\nconst company = $json.currentPositions?.[0]?.company;\n$json.company = company || \"\";\n$json.domain = \"\";\n\n// 4. Automatically lookup the Domain using Clearbit\nif (company) {\n    try {\n        const response = await this.helpers.httpRequest({\n            method: 'GET',\n            url: `https://autocomplete.clearbit.com/v1/companies/suggest?query=${encodeURIComponent(company)}`,\n            json: true\n        });\n\n        if (response && response.length > 0) {\n            $json.domain = response[0].domain;\n        }\n    } catch (error) {\n        // If it fails, domain stays blank and the Filter drops the row.\n    }\n}\n\nreturn $json;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
